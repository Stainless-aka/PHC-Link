NODE_ENV=development
PORT=3000

# Supabase: paste the Session pooler connection URI from
# Project Dashboard -> Connect -> Session pooler.
# Never commit the real URI or database password.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[SESSION-POOLER-HOST]:5432/postgres?sslmode=require

SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:5500
COOKIE_SECURE=false

# Required only for first-time administrator creation; use a random 32-byte secret.
BOOTSTRAP_SECRET=generate-a-unique-random-secret

# Shared secret for LoRa gateway and SMS/USSD alert ingestion (optional for session-authenticated web alerts).
ALERT_INGEST_KEY=generate-a-separate-random-secret
